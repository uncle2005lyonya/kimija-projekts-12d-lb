        <td>Ķirbju sēklas, mandeles, Indijas rieksti</td>
      </tr>
      <tr>
        <td>Graudaugi</td>
        <td>Auzas, griķi, pilngraudu produkti</td>
      </tr>
      <tr>
        <td>Dārzeņi</td>
        <td>Spināti un citi zaļie lapu dārzeņi</td>
      </tr>
    </table>
  </div>
